#!/usr/bin/env bash
# opencode-copilot — "come in, type, go".
#   1. proxy running?         → start it if not
#   2. new commits on main?   → pull + rebuild + restart (proxy does it itself)
#   3. signed in?             → if not, show the device code and wait
#   4. exec opencode with this repo's provider config
set -euo pipefail
INSTALL_DIR="${M365_PROXY_DIR:-$HOME/.m365-copilot-proxy}"
# Port: PROXY_PORT env > LISTEN in the env file > 8080.
CONF_DIR="$HOME/.config/m365-copilot-proxy"
if [ -z "${PROXY_PORT:-}" ] && [ -f "$CONF_DIR/env" ]; then
  PROXY_PORT="$(sed -n 's/^LISTEN=.*:\([0-9]*\)$/\1/p' "$CONF_DIR/env" | tail -1)"
fi
PROXY_PORT="${PROXY_PORT:-8080}"
URL="http://127.0.0.1:$PROXY_PORT"

up() { curl -sf "$URL/healthz" >/dev/null 2>&1; }
wait_up() { for _ in $(seq 1 60); do up && return 0; sleep 0.5; done; return 1; }

if ! up; then
  echo "proxy: starting…"
  copilot-proxy start
  wait_up || { echo "proxy failed to start — see: copilot-proxy logs" >&2; exit 1; }
fi

# Check/apply updates. Synchronous; the proxy re-execs when idle, so wait
# for it to come back if it says it updated.
upd=$(curl -s -X POST "$URL/update" 2>/dev/null || echo '{}')
if echo "$upd" | grep -q '"updated":true'; then
  echo "proxy: updated → $(echo "$upd" | sed -n 's/.*"remote":"\([^"]*\)".*/\1/p'), restarting…"
  sleep 1; wait_up || { echo "proxy did not come back after update — see: copilot-proxy logs" >&2; exit 1; }
elif echo "$upd" | grep -q '"error"'; then
  echo "proxy: update check failed (continuing with current build): $upd" >&2
fi

# First-time sign-in: the service has no terminal, so read the code from /auth.
shown=""
for _ in $(seq 1 900); do
  st=$(curl -s "$URL/auth")
  echo "$st" | grep -q '"authenticated":true' && break
  msg=$(echo "$st" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
  if [ -n "$msg" ] && [ "$msg" != "$shown" ]; then
    echo; echo "=== Microsoft sign-in required ==="; echo "$msg"; echo; shown="$msg"
    # Browser mode: open the login URL for them.
    if echo "$msg" | grep -q '/auth/login'; then
      (xdg-open "$URL/auth/login" 2>/dev/null || open "$URL/auth/login" 2>/dev/null || true) &
    fi
  fi
  if echo "$st" | grep -q '"last_error"' && [ -z "$msg" ]; then
    echo "sign-in error: $(echo "$st" | sed -n 's/.*"last_error":"\([^"]*\)".*/\1/p')" >&2
    echo "restart the flow with: copilot-proxy restart" >&2; exit 1
  fi
  sleep 1
done

# Keep the two bin scripts current — the proxy self-updates the checkout,
# but these are copies. Re-exec if this launcher itself changed.
SELF="$(readlink -f "$0")"; BIN_DIR="$(dirname "$SELF")"
for b in copilot-proxy opencode-copilot; do
  src="$INSTALL_DIR/bin/$b"; dst="$BIN_DIR/$b"
  if [ -f "$src" ] && ! cmp -s "$src" "$dst"; then
    install -m 755 "$src" "$dst"
    [ "$b" = opencode-copilot ] && [ -z "${OC_RELAUNCHED:-}" ] && { echo "launcher: updated, relaunching…"; OC_RELAUNCHED=1 exec "$dst" "$@"; }
  fi
done

# Merge the m365 provider into the user's GLOBAL OpenCode config instead of
# replacing it via OPENCODE_CONFIG — replacing it silently dropped every MCP
# server / skill defined there ("not exposed in this session's toolset").
# Idempotent; keeps everything else; backs the file up once.
OC_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
mkdir -p "$(dirname "$OC_CFG")"
[ -f "$OC_CFG" ] || echo '{}' > "$OC_CFG"
[ -f "$OC_CFG.pre-m365.bak" ] || cp "$OC_CFG" "$OC_CFG.pre-m365.bak"
if command -v python3 >/dev/null; then
  python3 - "$OC_CFG" "$INSTALL_DIR/opencode.json" "$PROXY_PORT" <<'PY'
import json, sys, re
dst, tpl, port = sys.argv[1], sys.argv[2], sys.argv[3]
def load(p):
    txt = open(p).read()
    txt = re.sub(r'^\s*//.*$', '', txt, flags=re.M)  # tolerate // comments (jsonc)
    return json.loads(txt or '{}')
cfg, t = load(dst), load(tpl)
prov = t["provider"]["m365"]
prov["options"]["baseURL"] = f"http://127.0.0.1:{port}/v1"
cfg.setdefault("$schema", t.get("$schema", "https://opencode.ai/config.json"))
cfg.setdefault("provider", {})["m365"] = prov
cfg.setdefault("model", t.get("model", "m365/m365-copilot"))   # only if the user has no default
json.dump(cfg, open(dst, "w"), indent=2); open(dst, "a").write("\n")
PY
elif command -v node >/dev/null; then
  node -e '
const fs=require("fs");const [dst,tpl,port]=process.argv.slice(1);
const load=p=>JSON.parse(fs.readFileSync(p,"utf8").replace(/^\s*\/\/.*$/mg,"")||"{}");
const cfg=load(dst),t=load(tpl);const prov=t.provider.m365;prov.options.baseURL=`http://127.0.0.1:${port}/v1`;
cfg["$schema"]??=t["$schema"];(cfg.provider??={}).m365=prov;cfg.model??=t.model;
fs.writeFileSync(dst,JSON.stringify(cfg,null,2)+"\n");' "$OC_CFG" "$INSTALL_DIR/opencode.json" "$PROXY_PORT"
else
  echo "!! need python3 or node to merge $OC_CFG — add the provider from $INSTALL_DIR/opencode.json by hand (baseURL port $PROXY_PORT)" >&2
fi
unset OPENCODE_CONFIG   # never shadow the user's real config

# Keep the mcp-autopilot plugin current (it self-updates with the repo).
OC_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
mkdir -p "$OC_DIR/plugins"
cp "$INSTALL_DIR/opencode-plugin/mcp-autopilot.ts" "$OC_DIR/plugins/mcp-autopilot.ts"
[ -f "$OC_DIR/mcp-autopilot.json" ] || cp "$INSTALL_DIR/opencode-plugin/mcp-autopilot.example.json" "$OC_DIR/mcp-autopilot.json"

exec opencode "$@"
