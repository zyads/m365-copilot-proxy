{
  "// ": "copy to ~/.config/opencode/mcp-autopilot.json — every key optional",
  "enabled": true,
  "always": ["local-memory"],
  "never": [],
  "rules": {
    "\\b(pr|pull request|issue|github)\\b": ["github"],
    "\\b(jira|ticket)\\b": ["jira"],
    "\\b(remember|recall|memory|last time|where we left off)\\b": ["local-memory"]
  },
  "idleTurns": 8,
  "disableUnmatched": true
}
